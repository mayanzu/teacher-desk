# 教务系统地址（换学校时改这里）
JWXT_BASE=https://jwxt.slu.edu.cn:4060
# 服务器证书不受信任时设为 1（仅本地调试，存在中间人风险）
JWXT_INSECURE_TLS=0
# 扫码等待与轮询间隔（毫秒）
JWXT_QR_TIMEOUT_MS=300000
JWXT_POLL_MS=2000
# 后端监听端口与绑定地址（局域网访问请设 HOST=0.0.0.0）
PORT=8790
HOST=127.0.0.1
# 各浏览器会话的持久化目录（默认 <项目根>/.sessions；容器内设为 /data/sessions）
# SESSION_DIR=/data/sessions
# 上游（教务系统）并发上限：教学进度汇总、成绩登记册按此并发拉取，默认 3，设为 1 即完全串行
JWXT_FETCH_CONCURRENCY=3
# 查询缓存的兜底 TTL（毫秒），默认 300000（5 分钟）；键级分层见 server/cacheTtl.mjs
# JWXT_CACHE_TTL_MS=300000

# 按学期配置真实首周周一和作息；未配置时界面会标注估算。
# JWXT_CALENDAR='{"2026,0":{"semesterStart":"2026-09-07","times":{"1-2":["08:15","09:50"],"3-4":["10:05","11:40"],"5-6":["13:35","15:10"],"7-8":["15:20","16:55"],"9-10":["18:00","19:35"],"11-12":["19:40","21:15"]}}}'
# HTTPS 部署设为 1（HTTP 本机开发保持 0）。
COOKIE_SECURE=0

# 教务系统地址（换学校时改这里）
JWXT_BASE=https://jwxt.slu.edu.cn:4060
# 服务器证书不受信任时设为 1（仅本地调试，存在中间人风险）
JWXT_INSECURE_TLS=0
# 扫码等待与轮询间隔（毫秒）
JWXT_QR_TIMEOUT_MS=300000
JWXT_POLL_MS=2000
# 后端监听端口与绑定地址（局域网访问请设 HOST=0.0.0.0）
PORT=8790
HOST=127.0.0.1
# 各浏览器会话的持久化目录（默认 <项目根>/.sessions；容器内设为 /data/sessions）
# SESSION_DIR=/data/sessions

# ===== 上游调度（统一在 JwxtSession.request 的真实 fetch 上生效）=====
# 同一会话并发上限；教学进度汇总等任务也按它拆批。设为 1 即完全串行。
JWXT_FETCH_CONCURRENCY=3
# 同一教务源全局并发上限（所有浏览器会话共享）
JWXT_GLOBAL_CONCURRENCY=8
# 排队的请求上限；排满时明确返回 503，而不是无限堆积
JWXT_MAX_QUEUE=64
# 单次上游请求超时（毫秒）
JWXT_REQUEST_TIMEOUT_MS=30000

# ===== 缓存（条数 + 字节双预算，超预算按最近最少使用淘汰）=====
# 查询缓存的兜底 TTL（毫秒），默认 300000（5 分钟）；键级分层见 server/cacheTtl.mjs
# JWXT_CACHE_TTL_MS=300000
# 每会话查询缓存字节预算（默认 16 MiB）
# JWXT_QUERY_CACHE_BYTES=16777216
# 每会话导出缓存字节预算（默认 64 MiB）
# JWXT_EXPORT_CACHE_BYTES=67108864
# 所有活跃会话缓存合计的全局字节预算（默认 256 MiB）
# JWXT_CACHE_TOTAL_BYTES=268435456
# 单个对象准入上限，超过则不进缓存（默认 32 MiB）
# JWXT_MAX_OBJECT_BYTES=33554432

# 导出（PDF/Excel）结果缓存 TTL（毫秒），默认 300000；单次导出要 2 次上游往返，重复下载走缓存
# JWXT_EXPORT_TTL_MS=300000
# 成绩 PDF 文件名的教师名元数据查询预算（毫秒），默认 800；0 表示不查询（直接用回退文件名）
# JWXT_FILENAME_BUDGET_MS=800

# ===== 会话与预热 =====
# 会话存活探测的记忆时长（毫秒），默认 45000：探测会真的打一次教务，记忆期内不再重复探测；
# 设为 0 恢复「每个请求都探测」的旧行为。
# JWXT_SESSION_PROBE_TTL_MS=45000
# 会话文件活动时间戳的最小刷盘间隔（毫秒），默认 60000；设 0 恢复每个请求都同步刷盘
# JWXT_SESSION_TOUCH_MS=60000
# 设为 0 关闭登录后的后台预热（默认开启：登录后拉当前周课表、教学任务、成绩列表、进度列表）
# JWXT_WARMUP=0
# 预热失败后的最大重试次数（默认 3；失败不会被永久跳过）
# JWXT_WARMUP_ATTEMPTS=3

# ===== 观测 =====
# 设为 1 时，每个 API 请求结束后输出一行脱敏阶段耗时（total/queue/upstream/cache 命中计数）
# JWXT_PERF_LOG=1
# 设为 1 时，API 响应带 Server-Timing: total/queue/upstream（浏览器 Network 面板可直接看）
# JWXT_SERVER_TIMING=0

# 点名册 PDF 用的中文字体文件（TTF/OTF，不能是 .ttc 集合）。不设则自动探测常见路径：
# Windows 用 simhei/simkai/simfang/Deng，Linux 用 arphic/Noto，macOS 用 Arial Unicode；
# 都找不到时导出点名册 PDF 会明确报错（不会画出方框）。
# ROSTER_PDF_FONT=/usr/share/fonts/truetype/arphic-gbsn00lp/gbsn00lp.ttf

# 按学期配置真实首周周一和作息；未配置时界面会标注估算。
# JWXT_CALENDAR='{"2026,0":{"semesterStart":"2026-09-07","times":{"1-2":["08:15","09:50"],"3-4":["10:05","11:40"],"5-6":["13:35","15:10"],"7-8":["15:20","16:55"],"9-10":["18:00","19:35"],"11-12":["19:40","21:15"]}}}'
# HTTPS 部署设为 1（HTTP 本机开发保持 0）。
COOKIE_SECURE=0

# 登录页的「云服务器延迟」提示。只有部署方设置它时，前端登录页才会显示这段文字
# （随 /api/session 下发，见 server/index.mjs 的 DEMO_LATENCY_HINT）。
# 本地部署 / Windows 便携版不要设置：界面保持干净，也不会有无关说明。
# 例：DEMO_LATENCY_HINT='本演示站部署在海外云服务器，到教务系统每次往返约 0.4 秒，切换学期看进度会多等 10~30 秒，建议本地部署。'
# DEMO_LATENCY_HINT=

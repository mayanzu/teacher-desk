{
  "name": "teacher-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "教务系统现代化前端（喜鹊儿扫码登录 + 查询看板 + 教学进度录入）",
  "scripts": {
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint server tools tests",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "docker:build": "docker buildx build --platform linux/arm64 -t teacher-desk:latest --load .",
    "docker:save": "docker save -o teacher-desk-arm64.tar teacher-desk:latest"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "postject": "^1.0.0-alpha.6"
  }
}

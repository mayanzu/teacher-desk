# 教务系统地址（换学校时改这里）
JWXT_BASE=https://jwxt.slu.edu.cn:4060
# 服务器证书不受信任时设为 1（仅本地调试，存在中间人风险）
JWXT_INSECURE_TLS=0
# 扫码等待与轮询间隔（毫秒）
JWXT_QR_TIMEOUT_MS=300000
JWXT_POLL_MS=2000
# 后端监听端口与绑定地址（局域网访问请设 HOST=0.0.0.0）
PORT=8790
HOST=127.0.0.1
# 会话缓存路径（默认 <项目根>/.session.json；容器内可设为 /data/.session.json）
# SESSION_FILE=/data/.session.json
